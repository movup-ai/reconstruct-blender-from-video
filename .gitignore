# ---------------------------------------------------------------
# Python environment and caches
# ---------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Third-party libraries (upstream clones: MoGe, sam2, MotionBERT)
# Re-clone these instead of committing them.
# ---------------------------------------------------------------
third_party/

# ---------------------------------------------------------------
# Downloaded packages, wheels and caches (pip cache, torch, TensorRT, HF)
# ---------------------------------------------------------------
downloads/
*.whl

# ---------------------------------------------------------------
# Model weights and compiled engine caches
# ---------------------------------------------------------------
models/
*.pt
*.pth
*.onnx
*.engine
*.safetensors

# ---------------------------------------------------------------
# Secrets and local environment files
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
# config.json holds the DeepSeek API key and this PC's folders; the app writes a default one when it is missing
config.json
config.json.tmp
deepseek_key.txt

# ---------------------------------------------------------------
# Runtime state and logs
# ---------------------------------------------------------------
logs/
*.log
data/*.db
data/*.db-shm
data/*.db-wal

# ---------------------------------------------------------------
# Generated work: source footage, per-clip work folders, renders, deliveries
# (multi-GB; remove a line here if you do want that folder versioned)
# ---------------------------------------------------------------
SOURCE/
Work_auto/
SUBMIT/
output/
DELIVERY/
ISSUES/
_sandbox/

# ---------------------------------------------------------------
# Blender backup files
# ---------------------------------------------------------------
*.blend1
*.blend2

# ---------------------------------------------------------------
# OS / editor / tool-local files
# ---------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
.claude/worktrees/
data/removed.json

data/held.json
